# Every setting has a working default; this file only shows what can be moved.
# Copy to .env to use it. See README "Configuration" for the full table.

# DEBUG=True
# SECRET_KEY=change-me-in-production

# Postgres instead of the default SQLite file:
# DATABASE_URL=postgres://user:password@localhost:5432/fuel_route
# Redis instead of the default in-process cache:
# REDIS_URL=redis://localhost:6379/1

# The truck. Both are request-overridable; the tank is always Range / mpg.
# FUEL_MAX_RANGE_MILES=500.0
# FUEL_MPG=10.0

# The Corridor. CORRIDOR_MILES is request-overridable as max_detour_miles;
# the other two are internal knobs.
# CORRIDOR_MILES=10.0
# CORRIDOR_THINNING_MILES=1.0
# CORRIDOR_GRID_CELL_DEGREES=0.5

# How far from the start the first purchase may be, and how near a US place an
# endpoint must be to count as inside the USA.
# ORIGIN_FILL_RADIUS_MILES=30.0
# US_CONTAINMENT_RADIUS_MILES=50.0

# Route Token and cache.
# COORD_ROUNDING_DECIMALS=4
# ROUTE_CACHE_TTL_SECONDS=86400
# ROUTE_TOKEN_LENGTH=16

# The routing provider. Self-host OSRM with an HGV profile for production.
# OSRM_BASE_URL=https://router.project-osrm.org
# OSRM_TIMEOUT_SECONDS=10.0
# OSRM_RETRIES=1

# Build-time only: the coverage gate, and the three public-domain sources
# build_gazetteer downloads with its own (generous) timeout.
# GAZETTEER_COVERAGE_FLOOR=0.98
# GAZETTEER_DOWNLOAD_TIMEOUT_SECONDS=300.0
# GAZETTEER_PLACES_URL=...
# GAZETTEER_COUSUBS_URL=...
# GAZETTEER_GNIS_URL=...
